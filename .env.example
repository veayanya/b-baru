# =====================================================
# Backend Environment Variables — Sintra / Bapperida
# Copy file ini menjadi .env untuk development lokal
# Set nilai aslinya di Render Dashboard > Environment
# =====================================================

# Port server (Render otomatis set ini, tidak perlu diubah)
PORT=3000
NODE_ENV=production

# ── Database (Multi-DB Failover, maksimal 1000 slot) ──
# Connection string Neon PostgreSQL.
# Dapatkan dari: Neon Dashboard > Project > Connection Details
# WAJIB: gunakan URL yang mengandung "-pooler" di hostname
# Contoh: postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# DATABASE_URL     = slot 1 (primer, dipakai pertama)
# DATABASE_URL_2.. = slot cadangan. Saat slot aktif menyentuh ambang kuota,
#                    seluruh data otomatis dicadangkan lalu dipindahkan ke
#                    slot berikutnya yang masih lapang.
# PENTING: tiap slot harus PROJECT/ENDPOINT NEON YANG BERBEDA. URL yang
#          menunjuk host + database yang sama akan dianggap duplikat dan
#          diabaikan (percuma, kuotanya sama).
DATABASE_URL=
DATABASE_URL_2=
DATABASE_URL_3=
DATABASE_URL_4=
DATABASE_URL_5=
DATABASE_URL_6=
DATABASE_URL_7=
DATABASE_URL_8=
DATABASE_URL_9=
DATABASE_URL_10=

# Alternatif ringkas: satu variabel berisi daftar dipisah koma (maks 1000).
# Jika diisi, nilainya digabung dengan DATABASE_URL_* di atas.
# DATABASE_URLS=postgresql://...db1,postgresql://...db2

# ── Pengaturan Failover ───────────────────────────────
# Target quota aplikasi per database dalam decimal bytes.
# 5000 MB = 5,000,000,000 bytes. Ini bukan perubahan billing/plan Neon.
DB_MAX_SLOTS=1000
DB_QUOTA_BYTES=5000000000

# Pindah database saat pemakaian mencapai rasio ini (0.5 – 0.98). Default 0.85 (85%).
DB_QUOTA_THRESHOLD=0.85

# Interval pengecekan kuota dalam milidetik. Default 300000 (5 menit).
DB_MONITOR_INTERVAL_MS=300000

# Jumlah berkas cadangan migrasi yang disimpan di disk (data/migrations). Default 5.
DB_MIGRATION_KEEP=5

# ── Autentikasi ───────────────────────────────────────
# JWT secret: buat string random panjang (min 32 karakter)
# Generator: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── AI API Keys ───────────────────────────────────────
# Minimal salah satu diisi. Bisa juga diisi via panel Admin UI.
GEMINI_API_KEY=
# Model Gemini untuk menu AI Agen Chatbot RKA (opsional, default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
# Key cadangan bila kuota GEMINI_API_KEY habis (opsional, pisah koma)
# GEMINI_POOL_KEYS=
OPENAI_API_KEY=

# ── CORS ──────────────────────────────────────────────
# URL frontend Vercel kamu (pisahkan dengan koma jika lebih dari satu)
# Contoh: https://sintra.vercel.app,https://sintra-git-main-org.vercel.app
ALLOWED_ORIGINS=https://NAMA-PROYEKMU.vercel.app
